{
  "name": "health-food-shop",
  "version": "0.1.0",
  "private": true,
  "description": "健康食品跨境电商 — 商城（微信小程序 / H5）・管理画面（PC）・API",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node scripts/dev.js --only=api",
    "dev:shop": "node scripts/dev.js --only=api,shop",
    "dev:admin": "node scripts/dev.js --only=api,admin",
    "dev:fresh": "node scripts/dev.js --fresh",
    "dev:stop": "node scripts/dev-stop.js",

    "build": "npm run build --workspaces --if-present",
    "build:weapp": "npm run build:weapp -w @hfs/shop",
    "build:h5": "npm run build:h5 -w @hfs/shop",
    "build:admin": "npm run build -w @hfs/admin",
    "build:api": "npm run build -w @hfs/api",

    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "e2e": "npm run e2e -w @hfs/api"
  },
  "devDependencies": {
    "typescript": "^5.4.2"
  },
  "overrides": {
    "webpack": "5.91.0"
  },
  "engines": {
    "node": ">=18"
  }
}
