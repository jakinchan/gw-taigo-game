// ============================================================
// health-food-shop データモデル
//
// 金額は全て Int（分＝CNY の最小単位）で保持する。
// Decimal/Float を使うと丸め誤差で決済照合が破綻するため。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ユーザー
// ------------------------------------------------------------

enum MemberLevel {
  normal
  silver
  gold
  platinum
}

model User {
  id       String @id @default(cuid())
  /// 微信の openid。code2session で取得する。
  openId   String @unique
  /// 微信オープンプラットフォームの unionId（複数アプリ横断で同一人物を識別）
  unionId  String?
  nickname String @default("")
  avatar   String @default("")

  memberLevel MemberLevel @default(normal)
  points      Int         @default(0)

  /// 越境EC の通関申告には購入者本人の実名情報が必要
  realNameVerified Boolean   @default(false)
  realNameVerifiedAt DateTime?
  /// 実名・身分証番号は AES-256-GCM で暗号化して保存する（CryptoService）
  realNameEncrypted String?
  idCardEncrypted   String?
  /// 身分証番号の HMAC-SHA256。復号せずに同一人物を突合するために使う。
  /// 越境EC の年間購入限度額は「個人」単位で集計するので、アカウント単位では足りない。
  idCardHash        String?

  addresses Address[]
  orders    Order[]
  coupons   UserCoupon[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unionId])
  // 年間購入限度額の集計で User -> Order を引くために必要
  @@index([idCardHash])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiverName String
  phone        String
  province     String
  city         String
  district     String
  detail       String
  postalCode   String?
  isDefault    Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ------------------------------------------------------------
// 商品
// ------------------------------------------------------------

model Category {
  id       String  @id @default(cuid())
  /// { "zh-CN": "营养补充剂", "ja-JP": "栄養補助食品" }
  name     Json
  icon     String  @default("")
  sort     Int     @default(0)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())

  @@index([parentId, sort])
}

model Product {
  id         String   @id @default(cuid())
  sku        String   @unique
  name       Json
  subtitle   Json     @default("{}")
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  thumbnail String
  images    String[]

  /// 販売価格（分）
  priceCny         Int
  /// 参考価格（分）
  originalPriceCny Int?
  /// 原価（分）。粗利計算用で API では返さない。
  costCny          Int  @default(0)

  description Json @default("{}")
  ingredients Json @default("{}")
  /// 効能表記。中国の広告法・食品安全法に抵触しない承認済み文言のみを入れる。
  benefits    Json @default("{}")
  usage       Json @default("{}")
  /// 栄養成分表（GB 28050 準拠）
  nutrition   Json @default("[]")

  /// 保健食品批准文号（「蓝帽子」）。一般食品は null。
  approvalNumber String?
  originCountry  String  @default("JP")
  /// 越境EC（保税・直邮）対象か
  isCrossBorder  Boolean @default(true)
  /// 越境EC 商品 HS コード（通関申告と税率決定に必要）
  hsCode         String?
  /// 通関申告に必要な単位・数量・重量
  customsUnit    String  @default("011") // 011 = 个（海关単位コード）
  /// 正味重量（グラム）
  netWeightG     Int     @default(0)
  /// 総重量（グラム）
  grossWeightG   Int     @default(0)

  salesCount  Int   @default(0)
  rating      Float @default(5)
  reviewCount Int   @default(0)
  tags        Json  @default("[]")

  isNew    Boolean @default(false)
  isOnSale Boolean @default(false)
  isActive Boolean @default(true)

  batches    StockBatch[]
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([isNew, isActive])
  @@index([isOnSale, isActive])
  @@index([hsCode])
}

/// HS コード別の税率テーブル。
/// 跨境电商综合税 = （関税 + 増値税 + 消費税）で、品目ごとに税率が異なる。
/// 商品に税率を直接持たせると、税制改正のたびに全商品を更新することになる。
model HsCodeTaxRate {
  id     String @id @default(cuid())
  hsCode String @unique
  /// 品目名（管理画面表示用）
  name   Json
  /// 関税率。越境EC 小売輸入では原則 0%（暫定 0 税率）だが、
  /// 限度額を超えた分は一般貿易扱いになり関税が発生する。
  tariffRate Float @default(0)
  /// 増値税率（一般 13%、一部食品 9%）
  vatRate    Float @default(0.13)
  /// 消費税率（健康食品は通常 0%、化粧品等は課税）
  exciseRate Float @default(0)
  /// 越境EC 綜合税の優遇係数。現行は法定納税額の 70%。
  discount   Float @default(0.7)

  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hsCode, effectiveFrom])
}

/// 在庫ロット。FEFO（First Expired, First Out）で引き当てる。
model StockBatch {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNo   String
  /// 賞味期限
  expiryDate DateTime
  /// 入庫数
  quantity   Int
  /// 注文で確保済み（未出荷）の数
  reserved   Int      @default(0)
  /// 保税倉庫コード（越境EC の場合）
  warehouse  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNo])
  // FEFO の引き当てクエリがこのインデックスに乗る
  @@index([productId, expiryDate])
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  content String   @default("")
  images  String[]

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// ------------------------------------------------------------
// クーポン
// ------------------------------------------------------------

enum CouponType {
  amount
  percent
  shipping
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  title        Json
  /// amount なら割引額（分）、percent なら割引率（1-100）
  value        Int
  minAmountCny Int        @default(0)
  /// 発行上限。null は無制限。
  totalLimit   Int?
  usedCount    Int        @default(0)
  startsAt     DateTime   @default(now())
  expiresAt    DateTime

  userCoupons UserCoupon[]

  createdAt DateTime @default(now())
}

model UserCoupon {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  used     Boolean  @default(false)
  usedAt   DateTime?
  orderId  String?

  createdAt DateTime @default(now())

  @@unique([userId, couponId])
  @@index([userId, used])
}

// ------------------------------------------------------------
// 注文・決済
// ------------------------------------------------------------

enum OrderStatus {
  pending_payment
  pending_shipment
  shipped
  completed
  cancelled
  refunding
}

enum ShippingMethod {
  standard
  express
}

model Order {
  id      String      @id @default(cuid())
  /// 表示用注文番号。微信支付の out_trade_no にもこれを使う（32 文字以内）。
  orderNo String      @unique
  userId  String
  user    User        @relation(fields: [userId], references: [id])
  status  OrderStatus @default(pending_payment)

  addressId String
  address   Address @relation(fields: [addressId], references: [id])
  /// 住所は変更・削除されうるので、注文時点のスナップショットを保持する
  addressSnapshot Json

  shippingMethod ShippingMethod @default(standard)
  trackingNo     String?
  remark         String?

  // ---- 金額（すべて分） ----
  subtotalCny    Int
  shippingFeeCny Int @default(0)
  discountCny    Int @default(0)
  taxCny         Int @default(0)
  totalCny       Int

  // ---- 越境決済の為替スナップショット ----
  /// 注文確定時のレート（1 CNY = fxRate JPY）。表示の一貫性のために保存する。
  fxRate           Float
  fxQuotedAt       DateTime
  /// 参考の日本円換算額（円）。実際の入金額とは一致しない。
  totalJpyEstimate Int

  couponCode String?

  /// 通関申告に使った購入者（申告名義人）の身分証ハッシュ。
  /// 年間購入限度額の集計キー。注文時点の値を固定保存する。
  declarantIdHash String?

  items       OrderItem[]
  payments    Payment[]
  declaration CustomsDeclaration?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  shippedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  // 年間購入限度額の集計クエリがこのインデックスに乗る
  @@index([declarantIdHash, paidAt])
}

enum DeclarationStatus {
  pending    // 未送信
  submitted  // 海关へ送信済み・審査中
  accepted   // 受理
  rejected   // 差し戻し
  failed     // 送信エラー
}

/// 海关総署への申告（「三单对碰」の订单单）。
/// 決済単・物流単は微信支付／物流会社が個別に送信し、海关側で突合される。
model CustomsDeclaration {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status DeclarationStatus @default(pending)

  /// 电子口岸 企業備案番号
  ebpCode String
  ebcCode String
  /// 海关が採番する受理番号
  customsSerial String?
  /// 申告に使った guid（再送時も同一 guid を使う＝冪等キー）
  guid          String  @unique

  /// 送信したリクエストと受信したレスポンス。障害調査と監査のために残す。
  requestPayload  Json?
  responsePayload Json?

  /// 差し戻し理由
  rejectReason String?
  attempts     Int      @default(0)
  lastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// 商品名・画像は注文時点のスナップショット（後から商品が変更されても注文票は変わらない）
  sku       String
  nameSnapshot Json
  thumbnail String

  priceCny Int
  quantity Int
  /// 引き当てたロット番号（返品・リコール時の追跡に使う）
  batchNo  String?

  /// 通関申告用のスナップショット。税制改正後に過去の注文を再計算させないため、
  /// 適用した HS コードと税率を明細に固定保存する。
  hsCode           String?
  appliedTaxRate   Float   @default(0)
  taxCny           Int     @default(0)

  @@index([orderId])
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 'wechat_direct' | 'sbps'
  provider String
  /// 微信支付の prepay_id
  prepayId String?
  /// 微信支付の transaction_id（入金確定後に埋まる）
  transactionId String? @unique

  status PaymentStatus @default(pending)

  /// 請求額（CNY・分）
  amountCny Int
  /// 実際の入金額（JPY・円）。決済代行からの精算通知で埋める。
  settledJpy Int?
  /// 精算時に適用された実レート
  settledFxRate Float?

  /// 支付通知の生ペイロード。照合と障害調査のために保持する。
  rawNotify Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

/// 為替レートの履歴。表示レートの根拠を後から追跡できるようにする。
model FxRate {
  id       String   @id @default(cuid())
  base     String   @default("CNY")
  quote    String   @default("JPY")
  rate     Float
  source   String
  quotedAt DateTime @default(now())

  @@index([base, quote, quotedAt])
}
