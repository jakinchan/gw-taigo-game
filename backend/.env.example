# ============================================================
# health-food-shop API 環境変数
#
# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は .gitignore 済み。秘密鍵・API キーは絶対にコミットしないこと。
# ============================================================

# ---------- サーバ ----------
NODE_ENV=development
PORT=3000
# 小程序からのアクセスに Origin ヘッダは付かないが、H5 版と管理画面のために設定する
CORS_ORIGINS=http://localhost:10086,https://admin.example.com

# ---------- データベース ----------
# PostgreSQL を想定。MySQL を使う場合は prisma/schema.prisma の provider も変更する
DATABASE_URL=postgresql://postgres:password@localhost:5432/health_food_shop?schema=public

# ---------- Redis（キャッシュ・在庫ロック・冪等キー） ----------
REDIS_URL=redis://localhost:6379

# ---------- 微信小程序 ----------
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=your_app_secret

# ---------- 微信支付 (APIv3) ----------
# 商户号
WECHAT_MCH_ID=1900000000
# APIv3 密钥（32 文字）。商户平台で設定した値。
WECHAT_API_V3_KEY=your_32_char_api_v3_key_here____
# 商户 API 証明書のシリアル番号
WECHAT_MCH_CERT_SERIAL=1234567890ABCDEF1234567890ABCDEF12345678
# 商户 API 秘密鍵（apiclient_key.pem）へのパス。
# 本番では KMS / Secrets Manager から読み込むこと。ファイル配置は開発用。
WECHAT_MCH_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# 支付結果通知の受け口。HTTPS 必須、かつ外部から到達可能であること。
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payment/wechat/notify

# ---------- 越境決済（決済代行を使う場合） ----------
# 'wechat_direct' = 微信支付と直接契約 / 'sbps' = SB ペイメントサービス経由
PAYMENT_PROVIDER=wechat_direct
# 加盟店の入金通貨。越境決済では CNY で受領し JPY で入金される想定。
SETTLEMENT_CURRENCY=JPY
SBPS_MERCHANT_ID=
SBPS_SERVICE_ID=
SBPS_API_KEY=
SBPS_API_ENDPOINT=https://stbfep.sps-system.com/api/xmlapi.do

# ---------- 為替レート ----------
# 表示用の参考レート取得元。空なら FX_FALLBACK_RATE を使う。
FX_RATE_API_URL=https://api.exchangerate.host/latest?base=CNY&symbols=JPY
FX_FALLBACK_RATE=21.0
# レートの再取得間隔（分）
FX_REFRESH_MINUTES=360

# ---------- 認証 ----------
# openssl rand -base64 48 で生成すること。本番では必ず変更する。
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- 越境EC 通関連携（海关総署 / 保税倉庫） ----------
CUSTOMS_ENABLED=false
CUSTOMS_APP_KEY=
CUSTOMS_APP_SECRET=
# 电子口岸 企業備案番号
CUSTOMS_EBP_CODE=
CUSTOMS_EBC_CODE=

# ---------- 物流 ----------
LOGISTICS_PROVIDER=sf
LOGISTICS_API_KEY=

# ---------- 監視 ----------
SENTRY_DSN=
LOG_LEVEL=debug
